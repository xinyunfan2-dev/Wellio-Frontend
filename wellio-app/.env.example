# Frontend is served by TanStack Start. Model/storage settings are server-only.
# Development visual fixtures can be enabled explicitly; ignored in production.
VITE_WELLIO_PREVIEW=0
# Local SQLite path defaults to .data/wellio.sqlite under the application cwd.
# WELLIO_DATABASE_PATH=/absolute/private/path/wellio.sqlite
# Behind a TLS proxy, force secure cookies. Local HTTP smoke tests leave unset.
# WELLIO_COOKIE_SECURE=1

# Optional AI configuration, read only on the server. All three are required.
# Select a model that supports tools, image input and structured output.
# Do not prefix secrets with VITE_. No model or protocol is selected implicitly.
WELLIO_AI_MODEL=
# responses or chat, matching the configured model/gateway capability
WELLIO_AI_PROTOCOL=
LOVABLE_API_KEY=
# Default gateway; an override must use HTTPS.
# WELLIO_AI_BASE_URL=https://ai.gateway.lovable.dev/v1

# Optional Lovable-managed Firecrawl search transport. Obtain the endpoint/token
# from the target project's managed connector; never use a native Firecrawl key.
# Endpoint must accept one v2/search-shaped POST including scrapeOptions.
# There is no default endpoint or fallback search/extraction service.
WELLIO_LOVABLE_FIRECRAWL_ENDPOINT=
WELLIO_LOVABLE_FIRECRAWL_TOKEN=

# For local configuration, copy to .env and load explicitly:
# node --env-file=.env ./node_modules/vite/bin/vite.js --host 127.0.0.1 --port 3100
# node --env-file=.env .output/server/index.mjs
