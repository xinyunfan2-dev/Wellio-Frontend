# Frontend-only development fixtures; production always calls FastAPI.
VITE_WELLIO_PREVIEW=0
# Server-side proxy target. The browser keeps using same-origin /api/*.
WELLIO_API_BASE_URL=http://127.0.0.1:8000
WELLIO_AGENT_BASE_URL=http://127.0.0.1:8001
# Configure DATABASE_URL and EXA_API_KEY in the backend repository, not here.
# Optional local stack helper for repositories checked out in separate locations:
# WELLIO_BACKEND_DIR=/absolute/path/to/Wellio-Backend
