{
  "name": "wellio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3100",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:backend": "vitest run tests/backend",
    "test:backend:production": "node scripts/backend-check.mjs production",
    "test:e2e": "playwright test",
    "start": "node .output/server/index.mjs",
    "test:python": "uv run --frozen --project ../wellio-backend pytest ../wellio-backend/tests",
    "export:python-seed": "node scripts/export-python-seed.mjs",
    "dev:stack": "node scripts/run-stack.mjs dev",
    "start:stack": "node scripts/run-stack.mjs start"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.66",
    "@heroui/react": "3.2.5",
    "@heroui/styles": "3.2.5",
    "@tanstack/react-router": "1.170.35",
    "@tanstack/react-start": "1.168.52",
    "ai": "7.0.98",
    "lucide-react": "0.577.0",
    "nitro": "3.0.260903-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
